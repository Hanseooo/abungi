{
  "name": "abungi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "pnpm test:domain && pnpm test:release && pnpm test:vitest",
    "test:domain": "node scripts/clean-domain-build.mjs && tsc -p tsconfig.domain.json && node --test tests/domain/*.test.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "test:vitest": "vitest run tests/vitest",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "node scripts/release-audit.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-window": "7.4.1"
  }
}
